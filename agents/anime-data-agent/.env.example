# Referencia: no se carga automáticamente desde la raíz.
# Python: definir estas variables en PowerShell antes de iniciar la API.
# Puntero verificado hacia un manifiesto de carga.
ANIME_DATASET_PATH=data/processed/current.json
ANIME_CONVERSATION_DB=data/conversations.sqlite3
# Next.js: definir en PowerShell o en apps/web/.env.local.
API_URL=http://127.0.0.1:8000

# Fase 7: modo explícito; no hay fallback silencioso si OpenAI falla.
ANIME_AGENT_MODE=rules
OPENAI_MODEL=gpt-5-mini
# Configurar mediante scripts/start_api.py (entrada oculta) o entorno local.
OPENAI_API_KEY=
# Máximos del prototipo; no representan un presupuesto monetario en OpenAI.
ANIME_MODEL_MAX_REQUESTS=4
ANIME_MODEL_MAX_TOOL_CALLS=6
ANIME_MODEL_MAX_OUTPUT_TOKENS=2048
ANIME_MODEL_TURN_TIMEOUT=60
ANIME_MODEL_MAX_INPUT_CHARS=60000

# Fase 9: Node MCP consulta esta API; no recibe OPENAI_API_KEY.
ANIME_API_URL=http://127.0.0.1:8000
ANIME_MCP_PORT=3001
# Solo para el cliente de comprobación:
ANIME_MCP_URL=http://127.0.0.1:3001/mcp
ANIME_WEB_URL=http://127.0.0.1:3000
# No guardar credenciales del túnel aquí: scripts/start_tunnel.py las pide ocultas.
